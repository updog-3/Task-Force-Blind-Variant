{
  "name": "task-force-blind-search-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Referee app for hidden Task Forces in an in-person blind game of Task Force: Carrier Battles in the Pacific",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "prestart": "vite build",
    "start": "tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
